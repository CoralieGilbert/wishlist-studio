# Copie ce fichier en ".env" (sans ".example") et remplis les valeurs.
# Le fichier ".env" est ignoré par Git : il ne sera jamais envoyé sur GitHub.

# Project Settings → Database → Connection string → URI
# (utilisé une seule fois, pour créer les tables — étape 3)
SUPABASE_DB_URL=

# Project Settings → API → Project URL
SUPABASE_URL=

# Project Settings → API → service_role key (secret, ne jamais exposer côté navigateur)
# (utilisé pour importer les données et les photos — étape 4)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → API → anon / public key
# (celle-ci est sans danger côté navigateur — utilisée plus tard par l'app elle-même, étape 5)
SUPABASE_ANON_KEY=
